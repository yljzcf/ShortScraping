{
  "name": "shortscraping",
  "version": "1.6.0",
  "private": true,
  "description": "ShortScraping browser extension and local CSV sync service",
  "scripts": {
    "test": "node tests/run.mjs",
    "update-sites": "node scripts/update-site-matches.mjs",
    "export-lark": "node scripts/export-lark-csv.mjs",
    "sync": "node server/sync-server.js",
    "start": "node server/sync-server.js",
    "stop": "node server/tools/stop.js",
    "restart": "node server/tools/stop.js && node server/sync-server.js",
    "fix-encoding": "node server/tools/fix-csv-encoding.js"
  }
}
